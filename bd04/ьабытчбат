-- =============================================================================
-- Вариант 3: Заказы + категории товаров (PostgreSQL)
-- =============================================================================
-- Содержит:
--   • Дерево категорий товаров (adjacency list)
--   • Таблицы orders / order_items / products
--   • Функцию order_total() — сумма позиций заказа
--   • Процедуру confirm_order() — перевод open → confirmed + запрет пустого
--   • Безопасную версию confirm_order_safe() (без гонки)
--   • Триггер, который фиксирует смену статуса в order_status_log
--   • Описание гонки проверки пустоты и способы защиты
--   • Примеры использования
-- =============================================================================

BEGIN;

-- -----------------------------------------------------------------------------
-- 1. Дерево категорий товаров
-- -----------------------------------------------------------------------------
CREATE TABLE categories (
    id          SERIAL PRIMARY KEY,
    name        TEXT NOT NULL,
    parent_id   INT REFERENCES categories(id) ON DELETE CASCADE
);

COMMENT ON TABLE categories IS 'Дерево категорий товаров (adjacency list)';

-- -----------------------------------------------------------------------------
-- 2. Товары
-- -----------------------------------------------------------------------------
CREATE TABLE products (
    id          SERIAL PRIMARY KEY,
    name        TEXT NOT NULL,
    category_id INT REFERENCES categories(id),
    price       NUMERIC(12,2) NOT NULL CHECK (price >= 0)
);

COMMENT ON TABLE products IS 'Товары, привязанные к категориям';

-- -----------------------------------------------------------------------------
-- 3. Заказы
-- -----------------------------------------------------------------------------
CREATE TABLE orders (
    id          SERIAL PRIMARY KEY,
    status      TEXT NOT NULL DEFAULT 'open'
                CHECK (status IN ('open', 'confirmed', 'cancelled')),
    created_at  TIMESTAMPTZ NOT NULL DEFAULT now()
);

COMMENT ON TABLE orders IS 'Заказы. Статусы: open → confirmed / cancelled';

-- -----------------------------------------------------------------------------
-- 4. Позиции заказа
-- -----------------------------------------------------------------------------
CREATE TABLE order_items (
    id          SERIAL PRIMARY KEY,
    order_id    INT NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
    product_id  INT NOT NULL REFERENCES products(id),
    quantity    INT NOT NULL CHECK (quantity > 0),
    price       NUMERIC(12,2) NOT NULL CHECK (price >= 0)  -- снимок цены на момент добавления
);

COMMENT ON TABLE order_items IS 'Позиции (строки) заказа';

-- -----------------------------------------------------------------------------
-- 5. Журнал смены статусов (для триггера)
-- -----------------------------------------------------------------------------
CREATE TABLE order_status_log (
    id          SERIAL PRIMARY KEY,
    order_id    INT NOT NULL REFERENCES orders(id),
    old_status  TEXT,
    new_status  TEXT NOT NULL,
    changed_at  TIMESTAMPTZ NOT NULL DEFAULT now()
);

COMMENT ON TABLE order_status_log IS 'История изменений статуса заказа (заполняется триггером)';

-- -----------------------------------------------------------------------------
-- 6. Функция: сумма позиций заказа
-- -----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION order_total(p_order_id INT)
RETURNS NUMERIC
LANGUAGE sql
STABLE
AS $$
    SELECT COALESCE(SUM(quantity * price), 0)
    FROM order_items
    WHERE order_id = p_order_id;
$$;

COMMENT ON FUNCTION order_total(INT) IS 'Возвращает сумму всех позиций указанного заказа';

-- -----------------------------------------------------------------------------
-- 7. Триггер: фиксирует смену статуса
-- -----------------------------------------------------------------------------
CREATE OR REPLACE FUNCTION log_order_status_change()
RETURNS TRIGGER
LANGUAGE plpgsql
AS $$
BEGIN
    IF OLD.status IS DISTINCT FROM NEW.status THEN
        INSERT INTO order_status_log (order_id, old_status, new_status)
        VALUES (NEW.id, OLD.status, NEW.status);
    END IF;
    RETURN NEW;
END;
$$;

CREATE TRIGGER trg_log_order_status
AFTER UPDATE OF status ON orders
FOR EACH ROW
EXECUTE FUNCTION log_order_status_change();

COMMENT ON FUNCTION log_order_status_change() IS 'Триггерная функция: пишет изменение статуса в order_status_log';

-- -----------------------------------------------------------------------------
-- 8. Процедура: перевод open → confirmed (с проверкой на пустоту)
-- -----------------------------------------------------------------------------
-- Внимание: эта версия содержит потенциальную гонку (см. раздел ниже).
-- Для продакшена используйте confirm_order_safe().
-- -----------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE confirm_order(p_order_id INT)
LANGUAGE plpgsql
AS $$
DECLARE
    v_status      TEXT;
    v_items_count INT;
BEGIN
    -- Блокируем строку заказа
    SELECT status
    INTO v_status
    FROM orders
    WHERE id = p_order_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Заказ % не найден', p_order_id;
    END IF;

    IF v_status <> 'open' THEN
        RAISE EXCEPTION 'Заказ % уже не в статусе open (текущий: %)', p_order_id, v_status;
    END IF;

    -- Проверка на пустоту
    SELECT COUNT(*)
    INTO v_items_count
    FROM order_items
    WHERE order_id = p_order_id;

    IF v_items_count = 0 THEN
        RAISE EXCEPTION 'Пустой заказ запрещён (order_id = %)', p_order_id;
    END IF;

    -- Меняем статус
    UPDATE orders
    SET status = 'confirmed'
    WHERE id = p_order_id;
END;
$$;

COMMENT ON PROCEDURE confirm_order(INT) IS 'Переводит заказ из open в confirmed. Пустой заказ запрещён.';

-- -----------------------------------------------------------------------------
-- 9. Безопасная версия процедуры (рекомендуется)
-- -----------------------------------------------------------------------------
-- Проверка пустоты и смена статуса выполняются в одном атомарном UPDATE.
-- Это устраняет классическую TOCTOU-гонку.
-- -----------------------------------------------------------------------------
CREATE OR REPLACE PROCEDURE confirm_order_safe(p_order_id INT)
LANGUAGE plpgsql
AS $$
BEGIN
    -- Блокируем заказ (чтобы два confirm не прошли одновременно)
    PERFORM 1 FROM orders WHERE id = p_order_id FOR UPDATE;

    UPDATE orders o
    SET status = 'confirmed'
    WHERE o.id = p_order_id
      AND o.status = 'open'
      AND EXISTS (
          SELECT 1
          FROM order_items oi
          WHERE oi.order_id = o.id
      );

    IF NOT FOUND THEN
        RAISE EXCEPTION
            'Нельзя подтвердить заказ %: он пустой, не существует или уже не в статусе open',
            p_order_id;
    END IF;
END;
$$;

COMMENT ON PROCEDURE confirm_order_safe(INT) IS 'Безопасный перевод open → confirmed без гонки проверки пустоты';

COMMIT;

-- =============================================================================
-- ОПИСАНИЕ ГОНКИ ПРОВЕРКИ ПУСТОТЫ (Race Condition)
-- =============================================================================
--
-- Классическая TOCTOU (Time-of-check to time-of-use):
--
--   Транзакция A:  SELECT COUNT(*) ... → видит 1 позицию
--   Транзакция B:  DELETE FROM order_items ... (удаляет последнюю позицию)
--   Транзакция A:  UPDATE orders SET status = 'confirmed'
--
-- Результат: подтверждён пустой заказ.
--
-- Даже SELECT ... FOR UPDATE на orders не спасает полностью,
-- если удаление позиций происходит в другой транзакции без блокировки.
--
-- Способы защиты:
--   1. confirm_order_safe()  — проверка + UPDATE в одном операторе (лучший вариант)
--   2. Дополнительно блокировать позиции: PERFORM 1 FROM order_items ... FOR UPDATE
--   3. Isolation level SERIALIZABLE (дорого, но гарантирует отсутствие аномалий)
--
-- =============================================================================

